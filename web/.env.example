# Public registered WEB / PKCE client; no privileged machine credential.
PORTAL_ORIGIN=https://portal.example.test
AUTH_ISSUER=https://identity.example.test/services
AUTH_CLIENT_ID=registered-public-client-id
PORTAL_REDIS_URL=redis://127.0.0.1:6379/0
PORTAL_REDIS_NAMESPACE=default
# Explicitly opt in only for loopback HTTP development. Never use for production.
PORTAL_ALLOW_INSECURE_LOOPBACK=false
# Optional explicit internal transport origin; discovery must still name AUTH_ISSUER.
# AUTH_TRANSPORT_ORIGIN=https://identity-internal.example.test
# Optional pinned organization token-response certificate, not the JWKS signing key.
# AUTH_TOKEN_RESPONSE_CERT_PEM=-----BEGIN CERTIFICATE-----...
